PORT=4000
HOST=0.0.0.0
GRPC_TARGET=localhost:50051
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_USER=3
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=30000
MAX_WS_BUFFER_BYTES=65536
GRPC_RECONNECT_MAX_ATTEMPTS=5
GRPC_RECONNECT_BASE_DELAY_MS=500

# ── Service Registry ──────────────────────────────────────────────────────────
# Format: SENTIO_SVC_<UPPERCASE_NAME>=http://host:port
# Key is normalised automatically: NODE_BACKEND → "node-backend"
SENTIO_SVC_NODE_BACKEND=http://localhost:3000
SENTIO_SVC_FASTAPI_BACKEND=http://localhost:8000

# ── Redis (Rate Limiting & Shared State) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Rate Limiting (Requests per minute) ───────────────────────────────────────
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_FASTAPI_MAX=25
RATE_LIMIT_NODE_MAX=120
RATE_LIMIT_DEFAULT_MAX=60

# ── Google Auth ───────────────────────────────────────────────────────────────
# Google OAuth Client Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=postmessage
GOOGLE_CLIENT_IDS=your-client-id.apps.googleusercontent.com
