# ============================================================
# Sentio — API Gateway (Node.js / Express)
# Copy this file to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# ----------------------------------------------------------
# Google OAuth 2.0
# Must match the credentials used by the frontend.
# GOOGLE_CLIENT_IDS: comma-separated list of allowed Client IDs
# (useful when you have both web and mobile client IDs).
# GOOGLE_REDIRECT_URI: use "postmessage" for the credential/one-tap flow,
# or a real URI if using the server-side code flow.
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=postmessage
GOOGLE_CLIENT_IDS=your-google-oauth-client-id.apps.googleusercontent.com

# ----------------------------------------------------------
# Upstream services — Service Registry
# Key format: SENTIO_SVC_<UPPERCASE_NAME>=http://host:port
# The gateway normalises the key automatically:
#   SENTIO_SVC_NODE_BACKEND   → service name "node-backend"
#   SENTIO_SVC_FASTAPI_BACKEND → service name "fastapi-backend"
# ----------------------------------------------------------
SENTIO_SVC_NODE_BACKEND=https://sentio-node-backend.onrender.com
SENTIO_SVC_FASTAPI_BACKEND=http://localhost:8000

# ----------------------------------------------------------
# gRPC — FastAPI backend
# PROTO_PATH is relative to the gateway root.
# ----------------------------------------------------------
GRPC_TARGET=localhost:50051
PROTO_PATH=./proto/sentio_gateway.proto

# gRPC reconnect behaviour
GRPC_RECONNECT_BASE_DELAY_MS=500
GRPC_RECONNECT_MAX_ATTEMPTS=5

# ----------------------------------------------------------
# WebSocket
# ----------------------------------------------------------
# Max binary frame size in bytes (default 64 KB)
MAX_WS_BUFFER_BYTES=65536

# Heartbeat ping interval (ms) and timeout before disconnect (ms)
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=30000

# Max concurrent WS connections across all users
MAX_CONNECTIONS=500
# Max concurrent WS connections for a single user
MAX_CONNECTIONS_PER_USER=3

# ----------------------------------------------------------
# Redis (session cache / rate-limit counters)
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------
# Rate limiting (requests per minute per IP)
# ----------------------------------------------------------
RATE_LIMIT_DEFAULT_MAX=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_NODE_MAX=120
RATE_LIMIT_FASTAPI_MAX=25
